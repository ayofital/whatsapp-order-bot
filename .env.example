# Copy this file to .env and fill in what you need.
# Nothing is required to try the bot locally: run `npm run chat`.

PORT=3000
# Public HTTPS URL of this server (e.g. from ngrok or your host). Used for webhooks and mock payment links.
PUBLIC_URL=http://localhost:3000
DATA_DIR=data
# Set to enable GET /orders (send it in the x-admin-token header).
ADMIN_TOKEN=

# --- Telegram (get a token from @BotFather) ---
TELEGRAM_BOT_TOKEN=
# "polling" works on your laptop with no public URL. Use "webhook" in production.
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=

# --- WhatsApp Cloud API (Meta for Developers > WhatsApp > API Setup) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; enter the same value in the Meta webhook settings.
WHATSAPP_VERIFY_TOKEN=
# App secret from Meta (App settings > Basic). Enables webhook signature checks.
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# --- Stripe (Dashboard > Developers > API keys). Use your sk_test_ key while testing. ---
# Leave empty to use built-in mock payment links.
STRIPE_SECRET_KEY=
# Signing secret of your webhook endpoint (whsec_...). Point the endpoint at <PUBLIC_URL>/stripe/webhook
# and subscribe it to checkout.session.completed.
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends the customer after paying / cancelling. Defaults to simple pages on this server.
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
